@url = http://localhost:3000/api/membresias

### 1. Listar (esperado: 200)
GET {{url}}

### 2. Crear una membresía (esperado: 201)
# @name crear
POST {{url}}
Content-Type: application/json

{
  "fechaInicio": "2026-10-15",
  "fechaFin": "2026-11-15",
  "estadoMembresia": "activa"
}

### Guardar el id de la membresía creada
@id = {{crear.response.body.data.id}}

### 3. Ver la creada (esperado: 200)
GET {{url}}/{{id}}

### 4. Crear sin fecha de inicio (esperado: 400)
# errores: ["La fecha de inicio es obligatoria"]
POST {{url}}
Content-Type: application/json

{
  "fechaFin": "2026-11-15",
  "estadoMembresia": "activa"
}

### 5. Crear con formato de fecha inválido (esperado: 400)
# errores: ["La fecha de inicio debe tener el formato YYYY-MM-DD"]
POST {{url}}
Content-Type: application/json

{
  "fechaInicio": "15-10-2026",
  "fechaFin": "2026-11-15",
  "estadoMembresia": "activa"
}

### 6. Crear con fecha en el pasado (esperado: 400)
# errores: ["La fecha de inicio de una membresia no puede ser en el pasado"]
POST {{url}}
Content-Type: application/json

{
  "fechaInicio": "2020-01-01",
  "fechaFin": "2026-11-15",
  "estadoMembresia": "activa"
}

### 7. Crear con fecha que no existe (esperado: 400)
# errores: ["La fecha de inicio no es una fecha válida"]
POST {{url}}
Content-Type: application/json

{
  "fechaInicio": "2026-02-31",
  "fechaFin": "2026-11-15",
  "estadoMembresia": "activa"
}

### 8. Crear con estado inválido (esperado: 400)
# errores: ["El estado de la membresía debe ser uno de: activa, inactiva, cancelada"]
POST {{url}}
Content-Type: application/json

{
  "fechaInicio": "2026-10-15",
  "fechaFin": "2026-11-15",
  "estadoMembresia": "pendiente"
}

### 9. Crear con varios datos inválidos juntos (esperado: 400)
# errores (todos en la misma respuesta):
#   - "La fecha de inicio debe tener el formato YYYY-MM-DD"
#   - "La fecha de fin debe tener el formato YYYY-MM-DD"
#   - "El estado de la membresía debe ser uno de: activa, inactiva, cancelada"
POST {{url}}
Content-Type: application/json

{
  "fechaInicio": "15/10/2026",
  "fechaFin": "15/11/2026",
  "estadoMembresia": "suspendida"
}

### 10. Crear segunda membresía para pruebas adicionales (esperado: 201)
# @name crearExtra
POST {{url}}
Content-Type: application/json

{
  "fechaInicio": "2026-12-01",
  "fechaFin": "2027-01-01",
  "estadoMembresia": "inactiva"
}

### Guardar el id de la segunda membresía
@idExtra = {{crearExtra.response.body.data.id}}

### 11. Id que no es un número (esperado: 400)
# "El id debe ser un número entero"
GET {{url}}/abc

### 12. Id que no existe (esperado: 404)
# "Membresia no encontrada"
GET {{url}}/99999

### 13. PUT completo (esperado: 200)
PUT {{url}}/{{id}}
Content-Type: application/json

{
  "fechaInicio": "2026-10-20",
  "fechaFin": "2026-11-20",
  "estadoMembresia": "cancelada"
}

### 14. PUT sin fecha de fin (esperado: 400)
# errores: ["La fecha de fin es obligatoria"]
PUT {{url}}/{{id}}
Content-Type: application/json

{
  "fechaInicio": "2026-10-20",
  "estadoMembresia": "activa"
}

### 15. PATCH de una sola propiedad (esperado: 200)
PATCH {{url}}/{{id}}
Content-Type: application/json

{ "estadoMembresia": "activa" }

### 16. PATCH sin datos (esperado: 400)
# "No hay datos para modificar"
PATCH {{url}}/{{id}}
Content-Type: application/json

{}

### 17. Eliminar la primera membresía (esperado: 200)
# "Membresia eliminada"
DELETE {{url}}/{{id}}

### 18. Ver la eliminada (esperado: 404)
# "Membresia no encontrada"
GET {{url}}/{{id}}

### 19. Eliminar la segunda membresía (esperado: 200)
DELETE {{url}}/{{idExtra}}

### 20. Listar para confirmar que quedó vacía (esperado: 200 y data vacío)
GET {{url}}