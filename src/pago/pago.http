@baseUrl = http://localhost:3000/api
@url = http://localhost:3000/api/pagos

### ==========================================
### PASO 0: LOGIN AUTOMÁTICO (Hacer clic en "Send Request" aquí una sola vez)
### ==========================================
# @name loginRequest
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "prueba.rol.auth@mail.com",
  "contrasenia": "passwordSeguro123"
}

### Extraemos automáticamente el token de la respuesta del bloque anterior
@token = {{loginRequest.response.body.data}}

# Reemplazar por el ID de una membresía existente.
@membresiaId = 1
# El ID del pago se toma de la respuesta del caso 3.
@idPago = {{crearPago.response.body.data.idPago}}

### 1. Obtener todos los pagos
GET {{url}}
Authorization: Bearer {{token}}

### 2. Obtener un pago por sus claves
# Consulta inicial: reemplazar el último 1 por un pago existente.
GET {{url}}/{{membresiaId}}/1
Authorization: Bearer {{token}}

### 3. Crear un pago para una membresía existente
# @name crearPago
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "membresiaId": {{membresiaId}},
  "monto": 25000,
  "metodoPago": "transferencia",
  "fechaLimitePago": "2026-11-10"
}

### 4. Crear un pago con datos inválidos (esperado: 400)
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "membresiaId": {{membresiaId}},
  "monto": -100,
  "metodoPago": "",
  "fechaLimitePago": "2026-02-30"
}

### 5. Crear un pago para una membresía inexistente (esperado: 404)
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "membresiaId": 99999,
  "monto": 25000,
  "metodoPago": "efectivo",
  "fechaLimitePago": "2026-11-10"
}

### 6. Actualizar todos los campos con PUT
PUT {{url}}/{{membresiaId}}/{{idPago}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "monto": 30000,
  "metodoPago": "efectivo",
  "fechaLimitePago": "2026-11-15"
}

### 7. Actualizar solamente el método con PATCH
PATCH {{url}}/{{membresiaId}}/{{idPago}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "metodoPago": "transferencia"
}

### 8. Intentar actualizar un pago inexistente (esperado: 404)
PATCH {{url}}/{{membresiaId}}/99999
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "metodoPago": "efectivo"
}

### 9. Confirmar que el pago fue abonado (esperado: 200)
PATCH {{url}}/{{membresiaId}}/{{idPago}}/confirmar
Authorization: Bearer {{token}}

### 10. Consultar el pago y comprobar la fecha registrada (esperado: 200)
GET {{url}}/{{membresiaId}}/{{idPago}}
Authorization: Bearer {{token}}

### 11. Intentar confirmar nuevamente (esperado: 409)
PATCH {{url}}/{{membresiaId}}/{{idPago}}/confirmar
Authorization: Bearer {{token}}

### 12. Eliminar el pago (esperado: 200)
# Este resultado corresponde al comportamiento actual; PG7 sigue pendiente de decisión.
DELETE {{url}}/{{membresiaId}}/{{idPago}}
Authorization: Bearer {{token}}

### 13. Comprobar que el pago eliminado ya no existe (esperado: 404)
GET {{url}}/{{membresiaId}}/{{idPago}}
Authorization: Bearer {{token}}
