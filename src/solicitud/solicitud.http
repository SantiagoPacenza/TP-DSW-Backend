@baseUrl = http://localhost:3000/api
@url = http://localhost:3000/api/solicitudes

### ==========================================
### PASO 0: LOGIN AUTOMÁTICO (Hacer clic en "Send Request" aquí una sola vez)
### ==========================================
# @name loginRequest
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "prueba.rol.auth@mail.com",
  "contrasenia": "passwordSeguro123"
}

### Extraemos automáticamente el token de la respuesta del bloque anterior
@token = {{loginRequest.response.body.data}}

# IMPORTANTE: reemplazá 1 por el ID de un usuario existente cuyo rol sea "cliente",
# y 2 por el ID de un usuario existente cuyo rol NO sea "cliente" (ej: admin o entrenador).
# El cliente debe tener una membresía activa y vigente (puede prepararse con preparar_datos.http).
@clienteId = 1
@noClienteId = 2

### 1. Listar solicitudes (esperado: 200)
GET {{url}}
Authorization: Bearer {{token}}

### 1.1. Filtrar pendientes (esperado: 200; solo estado pendiente o data vacío)
GET {{url}}?estado=pendiente
Authorization: Bearer {{token}}

### 1.2. Filtrar aprobadas (esperado: 200; solo estado aprobada o data vacío)
GET {{url}}?estado=aprobada
Authorization: Bearer {{token}}

### 1.3. Filtrar rechazadas (esperado: 200; solo estado rechazada o data vacío)
GET {{url}}?estado=rechazada
Authorization: Bearer {{token}}

### 1.4. Filtro inválido (esperado: 400)
GET {{url}}?estado=otro
Authorization: Bearer {{token}}

### 2. Crear una solicitud (esperado: 201)
# @name crear
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clienteId": {{clienteId}},
  "peso": 75,
  "masaMuscular": 32,
  "altura": 1.80,
  "objetivo": "Aumentar masa muscular",
  "lesionesPrevias": "Ninguna"
}

### Guardar el ID de la solicitud creada
@id = {{crear.response.body.data.id}}

### 3. Consultar la solicitud creada (esperado: 200)
GET {{url}}/{{id}}
Authorization: Bearer {{token}}

### 4. Crear sin objetivo (esperado: 400)
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clienteId": {{clienteId}},
  "peso": 75,
  "masaMuscular": 32,
  "altura": 1.80
}

### 5. Crear con peso inválido (esperado: 400)
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clienteId": {{clienteId}},
  "peso": -5,
  "masaMuscular": 32,
  "altura": 1.80,
  "objetivo": "Aumentar masa muscular"
}

### 6. Crear con cliente inexistente (esperado: 404)
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clienteId": 99999,
  "peso": 75,
  "masaMuscular": 32,
  "altura": 1.80,
  "objetivo": "Aumentar masa muscular"
}

### 7. Crear con usuario existente cuyo rol NO es cliente (esperado: 400)
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clienteId": {{noClienteId}},
  "peso": 75,
  "masaMuscular": 32,
  "altura": 1.80,
  "objetivo": "Aumentar masa muscular"
}

### 8. ID que no es un número (esperado: 400)
GET {{url}}/abc
Authorization: Bearer {{token}}

### 9. ID inexistente (esperado: 404)
GET {{url}}/99999
Authorization: Bearer {{token}}

### 10. Actualizar solicitud completa (esperado: 200)
PUT {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clienteId": {{clienteId}},
  "peso": 76,
  "masaMuscular": 33,
  "altura": 1.80,
  "objetivo": "Aumentar masa muscular",
  "lesionesPrevias": "Ninguna"
}

### 11. Actualizar solo el objetivo (esperado: 200)
PATCH {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "objetivo": "Mejorar fuerza y resistencia"
}

### 12. PATCH sin datos (esperado: 400)
PATCH {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### 13. Aprobar la solicitud (esperado: 200 y estado aprobada)
PATCH {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "estado": "aprobada" }

### 14. Rechazar la solicitud (esperado: 200 y estado rechazada)
PATCH {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "estado": "rechazada" }

### 15. Estado inválido (esperado: 400)
PATCH {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "estado": "otro" }

### 16. Eliminar solicitud (esperado: 200)
DELETE {{url}}/{{id}}
Authorization: Bearer {{token}}

### 17. Consultar la solicitud eliminada (esperado: 404)
GET {{url}}/{{id}}
Authorization: Bearer {{token}}

### 18. Listar solicitudes al finalizar (esperado: 200)
GET {{url}}
Authorization: Bearer {{token}}
