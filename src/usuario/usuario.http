@baseUrl = http://localhost:3000/api
@url = http://localhost:3000/api/usuarios

### ==========================================
### PASO 0: LOGIN AUTOMÁTICO (Hacer clic en "Send Request" aquí una sola vez)
### ==========================================
# @name loginRequest
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "carlos@mail.com",
  "contrasenia": "passwordSeguro123"
}

### Extraemos automáticamente el token de la respuesta del bloque anterior
@token = {{loginRequest.response.body.data}}


### ==========================================
### PRUEBAS DE USUARIOS (Todas usan el token de arriba)
### ==========================================

### 1. Listar (esperado: 200)
GET {{url}}
Authorization: Bearer {{token}}

### 2. Crear un cliente (esperado: 201)
# @name crear
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ 
  "rol": "cliente", 
  "nombre": "Pepe", 
  "apellido": "Perez", 
  "fechaNacimiento": "1996-04-12", 
  "nombreUsuario": "pepeperez", 
  "email": "pepe@mail.com", 
  "contrasenia": "clave123", 
  "telefono": "3413232825" 
}

### Guardar el id del usuario creado
@id = {{crear.response.body.data.id}}

### 3. Ver el creado (esperado: 200)
# La respuesta NO tiene que incluir contrasenia
# fechaNacimiento tiene que venir como "1995-04-12"
GET {{url}}/{{id}}
Authorization: Bearer {{token}}

### 4. Crear repetido (esperado: 409)
# "El nombre de usuario o el email ya está en uso"
# Va sin telefono a proposito: el telefono es opcional
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "cliente",
  "nombre": "Ana",
  "apellido": "Perez",
  "fechaNacimiento": "1995-04-12",
  "nombreUsuario": "anaperez",
  "email": "ana@mail.com",
  "contrasenia": "clave123"
}

### 5. Crear sin nombre (esperado: 400)
# errores: ["El nombre es obligatorio"]
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "cliente",
  "apellido": "Perez",
  "fechaNacimiento": "1995-04-12",
  "nombreUsuario": "sinnombre",
  "email": "sinnombre@mail.com",
  "contrasenia": "clave123"
}

### 6. Crear con varios datos invalidos juntos (esperado: 400)
# errores (los cuatro en la misma respuesta):
#   - "El email no tiene un formato válido"
#   - "El rol debe ser uno de: admin, cliente, entrenador"
#   - "La fecha de nacimiento debe tener el formato AAAA-MM-DD"
#   - "La contraseña debe tener al menos 8 caracteres"
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "jefe",
  "nombre": "Mal",
  "apellido": "Datos",
  "fechaNacimiento": "12/04/1995",
  "nombreUsuario": "maldatos",
  "email": "esto-no-es-un-mail",
  "contrasenia": "123"
}

### 7. Crear con mismo email, otro nombreUsuario (esperado: 409)
# "El nombre de usuario o el email ya está en uso"
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "cliente",
  "nombre": "Otra",
  "apellido": "Perez",
  "fechaNacimiento": "1995-04-12",
  "nombreUsuario": "otraperez",
  "email": "ana@mail.com",
  "contrasenia": "clave123"
}

### 8. Crear sin email (esperado: 400)
# errores: ["El email es obligatorio"]
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "cliente",
  "nombre": "Sin",
  "apellido": "Email",
  "fechaNacimiento": "1995-04-12",
  "nombreUsuario": "sinemail",
  "contrasenia": "clave123"
}

### 9. Nombre demasiado largo (esperado: 400)
# errores: ["El nombre no puede tener más de 30 caracteres"]
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "cliente",
  "nombre": "Abcdefghijklmnopqrstuvwxyzabcde",
  "apellido": "Perez",
  "fechaNacimiento": "1995-04-12",
  "nombreUsuario": "nombrelargo",
  "email": "largo@mail.com",
  "contrasenia": "clave123"
}

### 10. Fecha que no existe (esperado: 400)
# errores: ["La fecha de nacimiento no es una fecha válida"]
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "cliente",
  "nombre": "Fecha",
  "apellido": "Falsa",
  "fechaNacimiento": "1995-02-31",
  "nombreUsuario": "fechafalsa",
  "email": "falsa@mail.com",
  "contrasenia": "clave123"
}

### 11. Fecha futura (esperado: 400)
# errores: ["La fecha de nacimiento no puede ser en el futuro"]
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "cliente",
  "nombre": "Fecha",
  "apellido": "Futura",
  "fechaNacimiento": "2999-01-01",
  "nombreUsuario": "fechafutura",
  "email": "futura@mail.com",
  "contrasenia": "clave123"
}

### 12. Campos de mas: se ignoran (esperado: 201, id distinto de 999 y createdAt de hoy)
# @name crearExtra
POST {{url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": 999,
  "createdAt": "2000-01-01",
  "rol": "entrenador",
  "nombre": "Luis",
  "apellido": "Gomez",
  "fechaNacimiento": "1990-08-20",
  "nombreUsuario": "luisgomez",
  "email": "luis@mail.com",
  "contrasenia": "clave123"
}

### Guardar el id del segundo usuario
@idExtra = {{crearExtra.response.body.data.id}}

### 13. Id que no es un numero (esperado: 400)
# "El id debe ser un número entero"
GET {{url}}/abc
Authorization: Bearer {{token}}

### 14. Id que no existe (esperado: 404)
# "Usuario no encontrado"
GET {{url}}/99999
Authorization: Bearer {{token}}

### 15. PUT completo, sin contrasenia: se conserva la actual (esperado: 200)
PUT {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "cliente",
  "nombre": "Ana Maria",
  "apellido": "Perez",
  "fechaNacimiento": "1995-04-12",
  "nombreUsuario": "anaperez",
  "email": "ana@mail.com",
  "telefono": "3415551111"
}

### 16. PUT sin nombre (esperado: 400)
# errores: ["El nombre es obligatorio"]
PUT {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "cliente",
  "apellido": "Perez",
  "fechaNacimiento": "1995-04-12",
  "nombreUsuario": "anaperez",
  "email": "ana@mail.com"
}

### 17. PATCH de una sola parte (esperado: 200)
PATCH {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "telefono": "3415552222" }

### 18. PATCH con un email que ya existe (esperado: 409)
# "El nombre de usuario o el email ya está en uso"
PATCH {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "luis@mail.com" }

### 19. PATCH con contraseña nueva (esperado: 200; despues mirar el hash en la base)
PATCH {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "contrasenia": "otraclave456" }

### 20. PATCH sin datos (esperado: 400)
# "No hay datos para modificar"
PATCH {{url}}/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### 21. Eliminar el primero (esperado: 200)
# "Usuario eliminado"
DELETE {{url}}/{{id}}
Authorization: Bearer {{token}}

### 22. Ver el eliminado (esperado: 404)
# "Usuario no encontrado"
GET {{url}}/{{id}}
Authorization: Bearer {{token}}

### 23. Eliminar el segundo (esperado: 200)
DELETE {{url}}/{{idExtra}}
Authorization: Bearer {{token}}

### 24. Listar para confirmar que quedo vacia (esperado: 200 y data vacio)
GET {{url}}


### 25. Crear un entrenador para probar U3 (esperado: 201)
# @name crearEntrenador
POST {{url}}
Content-Type: application/json

{
  "rol": "entrenador",
  "nombre": "Carlos",
  "apellido": "Lopez",
  "fechaNacimiento": "1990-05-15",
  "nombreUsuario": "carlosentrenador",
  "email": "carlos.entrenador@mail.com",
  "contrasenia": "clave123"
}

### Guardar el ID del entrenador
@idEntrenador = {{crearEntrenador.response.body.data.id}}

### 26. Asignar disciplinas habilitadas (esperado: 200)
# Requiere que existan las disciplinas con ID 1 y 2.
PUT {{url}}/{{idEntrenador}}/disciplinas
Content-Type: application/json

{
  "disciplinaIds": [2, 4]
}

### 27. Reemplazar las disciplinas habilitadas (esperado: 200)
PUT {{url}}/{{idEntrenador}}/disciplinas
Content-Type: application/json

{
  "disciplinaIds": [2]
}

### 28. Intentar asignar una disciplina inexistente (esperado: 400)
PUT {{url}}/{{idEntrenador}}/disciplinas
Content-Type: application/json

{
  "disciplinaIds": [999999]
}

### 29. Intentar asignar disciplinas a un cliente (esperado: 409)
# @id debe seguir existiendo y corresponder a un cliente.
PUT {{url}}/{{id}}/disciplinas
Content-Type: application/json

{
  "disciplinaIds": [1]
}

### 30. Intentar asignar disciplinas a un usuario inexistente (esperado: 404)
PUT {{url}}/99999/disciplinas
Content-Type: application/json

{
  "disciplinaIds": [1]
}

### 31. Enviar IDs duplicados (esperado: 400)
PUT {{url}}/{{idEntrenador}}/disciplinas
Content-Type: application/json

{
  "disciplinaIds": [1, 1]
}

### 32. Quitar todas las disciplinas habilitadas (esperado: 200)
PUT {{url}}/{{idEntrenador}}/disciplinas
Content-Type: application/json

{
  "disciplinaIds": []
}
